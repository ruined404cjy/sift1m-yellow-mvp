# GIST1M 分区性能基线；复制为包根目录 gist.env 后修改绝对路径。
export MVP_CONFIG_PROFILE=perf
export MVP_DATASET=gist1m
export MVP_VECTOR_DIM=960
export MVP_ROW_COUNT=1000000
export MVP_QUERY_COUNT=1000
export MVP_GT_K=100
export MVP_RECALL_SOURCE=official_gist_groundtruth
export MVP_BASE_FILE=downloads/gist_base.fvecs
export MVP_QUERY_FILE=downloads/gist_query.fvecs
export MVP_GROUNDTRUTH_FILE=downloads/gist_groundtruth.ivecs
export JAVA_HOME=/opt/jdk-17
export SPARK_HOME=/opt/spark-3.5.9-bin-hadoop3
export ICEBERG_SPARK_RUNTIME_JAR=/opt/iceberg/iceberg-spark-runtime-3.5_2.12-1.11.0.jar
export MVP_SPARK_MASTER=local[*]
export MVP_SPARK_DRIVER_MEMORY=8g

export MVP_PYTHON_BIN=/absolute/path/to/sift1m-yellow-mvp/.venv/bin/python
export MVP_BRIDGE_SOURCE=/absolute/path/to/data_infra/deps/iceberg-rust-bridge
export MVP_CARGO_BIN=cargo
export MVP_GSQL_BIN=gsql
export MVP_DB=postgres
export MVP_PORT=37000
export MVP_GAUSSHOME=/path/to/gausshome

export MVP_WAREHOUSE_DIR=/data/omm/gist1m_perf_warehouse
export MVP_NAMESPACE=gist_bench_part
export MVP_TABLE=gist1m_part
export MVP_VECTOR_TYPE=floatvector

export MVP_ID_BASE=1
export MVP_DATA_FILES=32
export MVP_COMPRESSION=uncompressed
export MVP_PARTITION_BUCKETS=32
export MVP_TARGET_FILE_SIZE_BYTES=1073741824
# 单批覆盖完整 GIST1M，使 PyIceberg 通常生成 32 个分区数据文件。
export MVP_PYICEBERG_BATCH_ROWS=1000000
export MVP_BRIDGE_BATCH_ROWS=16384

export MVP_INDEX_FLAT_NAME=idx_gist_ivfflat
export MVP_INDEX_PQ_NAME=idx_gist_ivfpq
export MVP_INDEX_NAME=idx_gist_ivfpq
export MVP_INDEX_TYPE=ivf_pq
export MVP_INDEX_IMPLEMENTATION=ivf_pq
export MVP_NUM_CLUSTERS=1024
export MVP_SAMPLE_RATE=100000
export MVP_BUILD_WORKERS=8
# 960/60=16；固定 PQ 编码参数，运行后仍以 Registry algorithm_details 为准。
export MVP_NUM_SUB_QUANTIZERS=60
export MVP_PQ_NBITS=8
export MVP_NPROBE=10

export MVP_TEST_NQ=100
export MVP_TEST_K=10
export MVP_TEST_WARMUP=5
export MVP_RECALL_NQ=1000
# 从 1000 条官方 query 中含首尾等距抽取 N 条。
export MVP_QUERY_SAMPLING=equidistant

# 扩展矩阵覆盖小并行度、单 NUMA 节点 CPU 数和跨 NUMA 场景。
export MVP_MATRIX_K=10,100,1000,10000
export MVP_MATRIX_DOP=1,2,4,8,16,32,64
export MVP_MATRIX_MODES=index,fullscan
export MVP_MATRIX_NQ=100
export MVP_MATRIX_ROUNDS=1
export MVP_MATRIX_WARMUP=5

# 一键 perf 保持与 SIFT 基线相同的代表性子矩阵。
export MVP_PERF_K=10,100
export MVP_PERF_DOP=1,8
export MVP_PERF_NQ=100
export MVP_PERF_ROUNDS=1
export MVP_PERF_WARMUP=5
